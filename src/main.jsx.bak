import React,{useEffect,useMemo,useState} from 'react';import{createRoot}from'react-dom/client';import{MotionConfig,motion}from'framer-motion';import{strings as T}from'./content/strings.en.js';import{useGame}from'./store.js';import'./style.css';import '@fontsource/cinzel/700.css';import '@fontsource/playfair-display/600.css';import '@fontsource/inter/400.css';
const asset=(id)=>'/'+(window.NATION_ASSETS?.[id]|| (id.startsWith('B')?`assets/players/${id}.webp`:id.startsWith('C')?`assets/cards/${id}.webp`:id.startsWith('D')?`assets/thumbs/${id}.webp`:id.startsWith('E')?`assets/emblems/${id}.svg`:id.startsWith('G')?`assets/events/${id}.webp`:`assets/banners/${id}.webp`));
function App(){const g=useGame(),[sub,setSub]=useState('Overview'),[search,setSearch]=useState(''),[tab,setTab]=useState('All'),[name,setName]=useState(g.player.name),[party,setParty]=useState(null),[showDisc,setShowDisc]=useState(!localStorage.getItem('nation-disclaimer')), [showCreate,setShowCreate]=useState(false),[origin,setOrigin]=useState('Student Leader');
const [parties,setParties]=useState([]),[states,setStates]=useState([]),[activeState,setActiveState]=useState('Maharashtra');
useEffect(()=>{fetch('/data/POLITICAL_PARTIES.json').then(r=>r.json()).then(setParties).catch(()=>{});fetch('/data/STATES_REFERENCE.json').then(r=>r.json()).then(setStates).catch(()=>{});},[]);
const screen=g.screen, nav=T.nav; const banner=({'Main Menu':'A01','Create Identity':'A02','Dashboard':'A03','Player Profile':'A02','Party HQ':'A04','Parties':'A04','Elections':'A05','Parliament':'A06','State Assembly':'A07','Government':'A08','National Budget':'A08','Media':'A09','Economy':'A10','Projects':'A10'})[screen]||'A03';
const isMain=screen==='Main Menu'; const sections=T.sections[screen]||[]; const currentParty=parties.find(p=>p.party_id===g.player.partyId);
function go(s){g.setScreen(s);setSub((T.sections[s]||['Overview'])[0]);}
function startGame(){g.updatePlayer({name:name||'Arjun Verma',origin:origin,status:'Citizen'});go('Dashboard');setShowCreate(false)}
const visibleParties=parties.filter(p=>(p.party_name+' '+p.short_name+' '+p.ideology).toLowerCase().includes(search.toLowerCase()));
return <MotionConfig reducedMotion="user"><div className="game">
{!isMain&&<header className="topbar"><div className="brand" onClick={()=>go('Main Menu')}><span>N</span> NATION <small>RISE TO POWER</small></div><nav>{nav.map((n,i)=><button className={screen===n?'nav active':'nav'} key={n} onClick={()=>go(n)}><b>{['⌂','◈','♟','⚑','⚐','▤','♜','♙','▣','▥','✦','♧'][i]}</b>{n}</button>)}</nav><button className="profile-short" onClick={()=>go('Player Profile')}><img src={asset('B11')} onError={e=>e.currentTarget.style.display='none'}/><span>{g.player.name}<small>{g.player.status}</small></span>⌄</button><button className="icon-btn" onClick={()=>go('Settings')}>⚙</button></header>}
{isMain?<main className="hero" style={{backgroundImage:`linear-gradient(90deg,#061b29d9,#071c2a22),url(${asset('A01')})`}}><div className="hero-copy"><div className="eyebrow">PEOPLE · POLITICS · POWER · YOUR JOURNEY</div><h1>NATION</h1><h2>RISE TO POWER</h2><p>A nation is not just a place on the map. It is a journey of its people.</p><div className="hero-actions"><button className="gold big" onClick={()=>{setShowCreate(true);go('Create Identity')}}>▶ NEW GAME</button><button onClick={()=>g.load(0)}>↻ CONTINUE</button><button onClick={()=>go('Load Game')}>▣ LOAD GAME</button><button onClick={()=>go('Settings')}>⚙ SETTINGS</button><button onClick={()=>go('Credits')}>♟ CREDITS</button></div></div></main>:<div className="screen" style={{'--banner':`url(${asset(banner)})`}}><div className="screen-banner"><div><div className="eyebrow">PEOPLE · POLITICS · POWER · YOUR JOURNEY</div><h1>{screen}</h1><p>{screen==='Dashboard'?`Welcome, ${g.player.name}. Your political journey begins today.`:screen==='Parties'?'Explore parties. Compare policies. Choose your future.':screen==='India Map'?'A national overview across all states and union territories.':`Manage your journey. Shape decisions. Build a stronger nation.`}</p></div>{['Dashboard','Player Profile','Create Identity'].includes(screen)&&<img className="banner-player" src={asset('B11')} onError={e=>e.currentTarget.style.display='none'}/>}</div>
{screen==='Create Identity'?<div className="create-layout"><aside className="steps">{['Basic Information','Appearance & Portrait','Background & Biography','Starting Profile','Confirm Identity'].map((x,i)=><button className={sub===x?'selected':''} onClick={()=>setSub(x)} key={x}>{i+1}. {x}</button>)}</aside><div className="panel create-form"><h2>{sub}</h2>{sub==='Basic Information'?<><label>Full name<input value={name} onChange={e=>setName(e.target.value)} /></label><div className="two"><label>Age<input type="number" min="18" max="80" defaultValue={g.player.age} onChange={e=>g.updatePlayer({age:+e.target.value})}/></label><label>Gender<select onChange={e=>g.updatePlayer({gender:e.target.value})}><option>Male</option><option>Female</option><option>Other</option></select></label></div><label>Home State / Union Territory<select value={activeState} onChange={e=>setActiveState(e.target.value)}>{(states.length?states.map(s=>s.state_name||s.name||s.state):['Maharashtra','Delhi','Karnataka','Tamil Nadu']).map(s=><option key={s}>{s}</option>)}</select></label></>:sub==='Appearance & Portrait'?<><div className="portrait-grid">{Array.from({length:10},(_,i)=><button onClick={()=>g.updatePlayer({portrait:`B${String(i+1).padStart(2,'0')}`})} className="portrait-choice" key={i}><img src={asset(`B${String(i+1).padStart(2,'0')}`)}/></button>)}</div><label>Skin tone <input type="range" min="0" max="4" value={g.player.skin} onChange={e=>g.updatePlayer({skin:+e.target.value})}/></label></>:sub==='Background & Biography'?<div className="origin-grid">{['Student Leader','Social Worker','Business Professional','Journalist','Civil Servant','Political Family'].map((o,i)=><button className={origin===o?'origin selected':'origin'} onClick={()=>{setOrigin(o);g.updatePlayer({origin:o})}} key={o}><img src={asset(`C0${i+1}`)}/><b>{o}</b><small>{['Campus politics and youth networks','Community service experience','Industry and investment contacts','Media and public communication','Administration and policy experience','Established political connections'][i]}</small></button>)}</div>:sub==='Starting Profile'?<div className="stat-list">{['Political Influence','Public Support','Financial Resources','Media Recognition'].map((x,i)=><div key={x}><span>{x}</span><strong>{[30,25,40,20][i]+(['Student Leader','Social Worker','Business Professional','Journalist','Civil Servant','Political Family'].indexOf(origin)-2)*2}</strong><div className="meter"><i style={{width:`${[30,25,40,20][i]}%`}}/></div></div>)}</div>:<><h3>{name||'Arjun Verma'}</h3><p>Origin: {origin} · Starting status: Citizen</p><p>Fictional political world. Your choices define your career.</p></>}<div className="form-actions"><button onClick={()=>setSub(['Basic Information','Appearance & Portrait','Background & Biography','Starting Profile','Confirm Identity'][Math.max(0,['Basic Information','Appearance & Portrait','Background & Biography','Starting Profile','Confirm Identity'].indexOf(sub)-1)])}>← BACK</button><button className="gold" onClick={()=>sub==='Confirm Identity'?startGame():setSub(['Basic Information','Appearance & Portrait','Background & Biography','Starting Profile','Confirm Identity'][Math.min(4,['Basic Information','Appearance & Portrait','Background & Biography','Starting Profile','Confirm Identity'].indexOf(sub)+1)])}>{sub==='Confirm Identity'?'BEGIN YOUR JOURNEY':'CONTINUE →'}</button></div></div><aside className="panel note"><h3>✦ Your political journey</h3><p>Every political journey begins with a single step. Your background shapes your starting network and opportunities.</p></aside></div>:<><div className="workspace">{sections.length>0&&<aside className="sidebar">{sections.map((s,i)=><button key={s} className={sub===s?'chosen':''} onClick={()=>setSub(s)}><span>{['✦','▤','♟','⚑','♧','◈','▣','▥','⌂','✧'][i%10]}</span>{s}</button>)}</aside>}<main className="content">
{screen==='Dashboard'?<><div className="stats-row">{[['Current Position',g.player.status,'♟'],['Reputation',g.player.reputation,'★'],['Influence',g.player.influence,'✦'],['Public Support',g.player.support+'%','◈'],['Game Date',`Month ${g.month+1}`,'▦']].map(x=><Stat key={x[0]} item={x}/>)}</div><div className="dashboard-grid"><Panel title="Daily Briefing" banner="D02"><ul><li>Political activity is developing across the states.</li><li>Your next action can improve public support.</li><li>Build relationships and choose a party to begin your career.</li></ul></Panel><Panel title="Political Status"><Progress label="Influence" value={g.player.influence}/><Progress label="Public Support" value={g.player.support}/><Progress label="Reputation" value={g.player.reputation}/><button className="gold" onClick={()=>go('Player Profile')}>View Profile →</button></Panel><Panel title="Career Objectives" banner="D01"><p>☑ Establish your political identity</p><p>□ Join or create a party</p><p>□ Build a public support network</p><p>□ Prepare for your first election</p></Panel><Panel title="Upcoming Elections" banner="D03"><p>State Assembly cycle</p><strong>April 2027 · Opening scenario</strong><p>Lok Sabha cycle · May 2029</p></Panel><Panel title="Recent News"><p>National policy discussions continue.</p><p>Regional leaders prepare for upcoming sessions.</p></Panel><Panel title="National Situation"><div className="mini-stats"><span>Governance<br/><b>Active</b></span><span>Economy<br/><b>Stable</b></span><span>Public mood<br/><b>Watchful</b></span></div></Panel></div></>:screen==='Parties'?<div className="party-layout"><div className="party-list"><div className="tools"><input placeholder="Search party or ideology..." value={search} onChange={e=>setSearch(e.target.value)}/><span>{visibleParties.length} parties</span></div><div className="party-grid">{visibleParties.map(p=><button className={`party-card ${party?.party_id===p.party_id?'picked':''}`} key={p.party_id} onClick={()=>setParty(p)}><Emblem p={p}/><div><b>{p.party_name}</b><small>{p.ideology||p.party_type}</small><small>Strength {p.national_strength??'—'}</small></div><span>›</span></button>)}</div></div><Panel title={party?.party_name||'Select a party'}><p>{party?.founding_background||'Choose a party to view its fictional profile, ideology and strength parameters.'}</p>{party&&<><div className="mini-stats"><span>Ideology<br/><b>{party.ideology}</b></span><span>Founded<br/><b>{party.founding_year}</b></span><span>Organisation<br/><b>{party.organisation_strength}</b></span></div><button className="gold" onClick={()=>{g.updatePlayer({partyId:party.party_id});g.notify(`Membership joined: ${party.party_name}`)}}>{g.player.partyId===party.party_id?'CURRENT PARTY':'JOIN PARTY'}</button></>}</Panel></div>:screen==='India Map'?<><div className="map-legend"><span>State / UT tile cartogram · no geographic borders</span><span>■ Fictional party control</span></div><div className="tile-map">{(states.length?states: Array.from({length:36},(_,i)=>({state_name:['Andhra Pradesh','Arunachal Pradesh','Assam','Bihar','Chhattisgarh','Goa','Gujarat','Haryana','Himachal Pradesh','Jharkhand','Karnataka','Kerala','Madhya Pradesh','Maharashtra','Manipur','Meghalaya','Mizoram','Nagaland','Odisha','Punjab','Rajasthan','Sikkim','Tamil Nadu','Telangana','Tripura','Uttar Pradesh','Uttarakhand','West Bengal','Andaman and Nicobar Islands','Chandigarh','Dadra and Nagar Haveli and Daman and Diu','Delhi','Jammu and Kashmir','Ladakh','Lakshadweep','Puducherry'][i]}))).slice(0,36).map((s,i)=><button key={i} className={`state-tile c${i%6}`} onClick={()=>setActiveState(s.state_name||s.name||s.state)}>{s.state_name||s.name||s.state}</button>)}</div><Panel title={activeState}><p>State profile and political control</p><div className="mini-stats"><span>Assembly<br/><b>Seed data</b></span><span>Government<br/><b>Simulation foundation</b></span><span>Next cycle<br/><b>Scheduled</b></span></div><p className="muted">Constituency records supplied with the game are fictional seed records, not official boundaries.</p></Panel></>:screen==='Load Game'?<div className="slot-grid">{[0,1,2].map(i=><Panel title={`Save Slot ${i+1}`} key={i}><p>{(()=>{try{const x=JSON.parse(localStorage.getItem('nation-save-'+i));return x?`${x.player.name} · Month ${x.month}`:'Empty slot'}catch{return 'Empty slot'}})()}</p><button className="gold" onClick={()=>g.load(i)}>LOAD</button><button onClick={()=>g.save(i)}>SAVE CURRENT</button></Panel>)}</div>:screen==='Settings'?<Panel title="Settings"><label>UI sound volume <input type="range" min="0" max="1" step=".05" value={g.settings.volume} onChange={e=>g.settings.volume=+e.target.value}/></label><p>Landscape-first interface · English</p><button className="gold" onClick={()=>g.notify('Settings saved locally')}>SAVE SETTINGS</button></Panel>:screen==='Credits'?<Panel title="Credits & Fictional Disclaimer"><p>{T.disclaimer}</p><p>Nation: Rise to Power · Version 1.0.0 · Offline-first game project.</p></Panel>:screen==='Player Profile'?<><div className="profile-header"><img src={asset(g.player.portrait||'B11')} onError={e=>e.currentTarget.style.display='none'}/><div><h2>{g.player.name}</h2><p>{g.player.status} · {g.player.origin} · {currentParty?.party_name||'Independent citizen'}</p><p>Home: {activeState}</p></div></div><div className="dashboard-grid">{['Attributes','Skills & Experience','Relationships','Career Opportunities','Personal Finance','Political History','Achievements'].map((x,i)=><Panel title={x} key={x}><p>{[['Leadership','Communication','Strategy'],['Campaign Management','Public Speaking','Policy Understanding'],['Party network','Community contacts','Mentors'],['Join a party','Organise a rally','Stand for election'],['Game credits','Monthly income','Campaign funds'],['Political journey','Past decisions','Public record'],['First steps','Public service','Legacy'][i]][0]}</p><Progress label={['Leadership','Communication','Strategy'][i%3]} value={[65,70,55,42,35,28,10][i]}/></Panel>)}</div></>:<GenericScreen screen={screen} sub={sub} g={g} parties={parties} states={states}/>}
</main></div></>}</div>
{!isMain&&<footer><span>FICTIONAL POLITICAL SIMULATION · OFFLINE</span><span>MONTH {g.month+1} · <button onClick={()=>g.save(0)}>SAVE</button> <button className="gold" onClick={g.endTurn}>END TURN ▶</button></span></footer>}
{showDisc&&<div className="modal-back"><div className="modal"><h2>Before you begin</h2><p>{T.disclaimer}</p><button className="gold" onClick={()=>{localStorage.setItem('nation-disclaimer','1');setShowDisc(false)}}>I UNDERSTAND</button></div></div>}
{g.toast&&<button className="toast" onClick={g.dismissToast}>{g.toast} ×</button>}
</div></MotionConfig>}
function Stat({item}){return <div className="stat"><span>{item[2]}</span><small>{item[0]}</small><strong>{item[1]}</strong></div>}
function Panel({title,children,banner}){return <section className="panel"><h3>{title}</h3>{banner&&<img className="panel-banner" src={'/assets/thumbs/'+banner+'.webp'} onError={e=>e.currentTarget.style.display='none'}/>}<div className="panel-body">{children}</div></section>}
function Progress({label,value}){return <div className="progress"><div><span>{label}</span><b>{value}%</b></div><i><em style={{width:`${Math.max(0,Math.min(100,value))}%`}}/></i></div>}
function Emblem({p}){const id=({NDP:'E01_NDP_emblem',PRP:'E02_PRP_emblem',NPC:'E03_NPC_emblem',FPF:'E04_FPF_emblem'})[p.party_id]||'';return <div className="emblem">{id?<img src={`/assets/emblems/${id}.svg`}/>:<b>{p.short_name||'✦'}</b>}</div>}
function GenericScreen({screen,sub,g,parties,states}){const [action,setAction]=useState('');const content={
'Party HQ':[['Party Overview','Party leadership, membership, state units and organisational health.'],['Leadership','Leadership roles from supplied fictional data.'],['Members','Party membership and organisation overview.'],['Candidates','Candidate pool is loaded from supplied dataset on demand.'],['State Units','Regional party organisation and local networks.'],['Funding','Track fictional game-credit funding and expenses.'],['Manifesto','Create policy priorities for your party.'],['Alliances','Review coalition compatibility and potential partners.'],['Campaign Strategy','Plan outreach, speeches, rallies and campaign allocation.'],['Meetings','Schedule party meetings and record decisions.'],['Internal Decisions','Review party resolutions and internal governance.']],
'Elections':[['Election Calendar','Opening scenario: State Assembly polling 5 April 2027; results 10 April 2027. Lok Sabha polling 6 May 2029; results 12 May 2029.'],['Election Commission','Nomination rules, scrutiny, polling and dispute procedures.'],['Constituencies','Fictional constituency records supplied with this project.'],['Candidates','Candidate profiles are partitioned by state for lazy loading.'],['Nominations','Nomination workflow foundation: eligibility, affiliation and seat checks.'],['Campaigns','Campaign action controls and fictional spending.'],['Polling','Polling stage foundation. Full deterministic election simulation is not complete in this build.'],['Counting & Results','Result review interface foundation.'],['Complaints & Courts','Record a complaint, evidence and review status.'],['By-elections','By-election calendar and seat vacancy workflow.']],
'Parliament':[['Lok Sabha','543-seat national chamber. Seat arc visualises the chamber scale.'],['Rajya Sabha','Upper chamber overview.'],['Members of Parliament','Fictional members and party affiliation.'],['Bills','Draft, review and vote on legislation (foundation).'],['Debates','Debate schedule and session notes.'],['Voting','Voting UI foundation.'],['Committees','Committee membership and work items.'],['Confidence Motions','Confidence and no-confidence motion tracker.']],
'State Assembly':[['State Selector','Select a state or union territory from the supplied reference data.'],['Assembly Seats','Seat composition and vacancies.'],['MLAs','Fictional assembly member records.'],['Chief Minister & Cabinet','State executive overview.'],['State Bills','State legislative workflow foundation.'],['Confidence Motions','State government confidence tracker.'],['State Assembly Elections','Five-year terms and early dissolution foundation.']],
'Government':[['Government Overview','Central and state government overview.'],['Cabinet Ministers','Cabinet assignment foundation.'],['Ministries','Home Affairs, Finance, Internal Affairs, Defence, Education, Health, Agriculture, Infrastructure, Rural Development and Environment.'],['Policies','Policy proposals and effect tracking foundation.'],['Schemes','Public scheme directory foundation.'],['Projects','Project approval and progress tracking.'],['Budget','Shared economy source of truth is planned in data/economy.json.'],['Performance','Government performance indicators.'],['Approvals','Pending decisions and approval workflow.'],['Crisis Management','Crisis decision log foundation.']],
'Media':[['News Overview','Fictional headlines and media sentiment.'],['Press Releases','Compose and store a press release locally.'],['Public Speeches','Prepare a speech and public address.'],['Social Media','Offline simulated post composer.'],['News Coverage','Coverage tracking foundation.'],['Public Opinion','Public sentiment trend foundation.'],['Major Headlines','Major fictional headline feed.'],['Crisis Communication','Response planning foundation.'],['Media Campaigns','Campaign setup foundation.'],['Fact Check','Review fictional claims and sources.']],
'Economy':[['Economic Overview','Shared economy model foundation.'],['Revenue & Budget','Revenue categories and allocations.'],['Sectors','Agriculture, manufacturing, services, infrastructure and green energy.'],['Infrastructure','Project pipeline and infrastructure priorities.'],['Industry & Investment','Investment policy and industrial development.'],['Employment','Employment and labour indicators.'],['Trade & Exports','Trade and export indicators.'],['Social Welfare','Welfare schemes and public outcomes.'],['Economic Policies','Policy decisions and tracked effects.'],['Targets & Reports','Economic targets and reports.']],
'National Budget':[['Budget Overview','Annual budget summary.'],['Revenue Sources','Revenue categories.'],['Expenditure','Spending by sector.'],['State Allocation','State allocation overview.'],['Schemes & Projects','Scheme and project allocations.'],['Financial Reports','Fiscal reports.'],['Approvals','Budget approval workflow.'],['Fiscal Policy','Fiscal policy options.'],['Budget History','Budget history.']],
'Projects':[['Projects Overview','Project portfolio and status.'],['New Projects','Create a project record.'],['Ongoing Projects','Projects currently under implementation.'],['Completed Projects','Completed project records.'],['Sectors','Project sectors.'],['Approvals','Project approval queue.'],['Resource Allocation','Allocate fictional game credits.'],['Impact Reports','Project impact reporting.'],['Public Feedback','Feedback log.'],['Project Monitoring','Progress and risk monitoring.']],
'Events':[['Timeline','Chronological event timeline.'],['Daily Decisions','Decisions that advance with the time engine.'],['Political Crises','Political crisis event log.'],['Court Cases','Court case tracker.'],['Scandals','Scandal and reputation tracker.'],['Scheduled Meetings','Meeting schedule.'],['Research & Intelligence','Intelligence reports foundation.']],
'Notifications':[['All','All player notifications.'],['Important','Important alerts.'],['Policy','Policy updates.'],['Events','Event notices.'],['Reports','Report availability.'],['Personal Messages','Personal message inbox.'],['Official Letters','Official letters inbox.'],['Party Messages','Party messages inbox.'],['Meeting Invitations','Meeting invitation inbox.'],['System Alerts','System alerts.']]
};const desc=(content[screen]||[]).find(x=>x[0]===sub)?.[1]||`${sub} workspace and management tools.`;return <div className="generic-grid"><Panel title={sub}><p>{desc}</p><div className="action-row"><button className="gold" onClick={()=>{setAction('A new '+sub.toLowerCase()+' record was created.');g.notify(action||`${sub} action recorded locally.`)}}>＋ NEW / TAKE ACTION</button><button onClick={()=>setAction('View refreshed at month '+(g.month+1))}>↻ REFRESH</button></div>{action&&<p className="notice">{action}</p>}<div className="data-table"><div><b>Item</b><b>Status</b><b>Details</b></div>{[1,2,3,4].map(i=><div key={i}><span>{sub} {i}</span><span className="pill">{i===1?'Active':'Available'}</span><span>Month {g.month+1}</span></div>)}</div></Panel><Panel title="Quick Overview"><Progress label="Readiness" value={38}/><Progress label="Organisation" value={54}/><Progress label="Public outlook" value={47}/><p className="muted">Simulation systems are foundation-only in v1.0.0. Full political/economic resolution is not represented as complete.</p></Panel></div>}
createRoot(document.getElementById('root')).render(<App/>);